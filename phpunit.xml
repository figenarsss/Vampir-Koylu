<?xml version="1.0" encoding="UTF-8"?>
<!-- Varsayılan test çalıştırması: tüm servisler PDO repository'leri ile (bellek içi SQLite) çalışır. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="storage/phpunit-cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Vampir Köylü">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="TEST_BACKEND" value="sqlite" force="true"/>
    </php>
</phpunit>
